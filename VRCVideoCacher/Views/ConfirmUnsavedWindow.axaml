<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VRCVideoCacher.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:l="using:Jeek.Avalonia.Localization"
        x:Class="VRCVideoCacher.Views.ConfirmUnsavedWindow"
        x:DataType="vm:ConfirmUnsavedViewModel"
        Title="Unsaved Changes"
        Width="450" Height="190"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#FFB74D"/>
            <TextBlock Text="Unsaved Rules Changes" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1" Text="You have unsaved changes in your rules. Do you want to save or discard your changes before leaving?"
                   TextWrapping="Wrap" Foreground="#CCCCCC" VerticalAlignment="Center"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Command="{Binding CancelCommand}" Content="{l:Localize Cancel}"/>
            <Button Command="{Binding DiscardCommand}" Content="Discard" Classes="danger"/>
            <Button Command="{Binding SaveCommand}" Content="{l:Localize Save}" Classes="accent"/>
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#1DB954"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E57373"/>
        </Style>
    </Window.Styles>
</Window>
